# גיבויים ידניים — נקודות שחזור שלא נכללות בגיטלוג
# (מכילות גם מצב localStorage של המשתמש; ההיסטוריה מעכשיו היא הגיטלוג עצמו)
backups/

# תלות-סביבה תקנית (מיזוג עתידי)
node_modules/

# זבל מערכת
Thumbs.db
.DS_Store
*.log
# Measurement scratch output (shared across agents, not part of the project)
*.measure-*-out.json

# מטמון מחקר — נבנה מחדש אוטומטית; לא נשמר בגיט
data/research/cache/
data/research/street-list-raw.csv

# Local credentials; keep only explicit, secret-free example templates tracked.
.env
.env.*
!.env.example

# Output of the optional local static-copy helper.
/publish/
