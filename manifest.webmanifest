{
  "name": "ירושלים ברגל — יומן ביקורים",
  "short_name": "ירושלים ברגל",
  "description": "סמנו כל רחוב בירושלים שבו הייתם, עם תאריך והערה, ועקבו אחרי ההתקדמות לפי שכונה.",
  "lang": "he",
  "dir": "rtl",
  "id": "./",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#fbf8f3",
  "theme_color": "#b5601f",
  "categories": ["travel", "lifestyle"],
  "icons": [
